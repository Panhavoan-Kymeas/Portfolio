---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../utils/paths';
interface AdjacentLink { href: string; title: string; }
interface Props { title: string; description: string; date?: Date; tags?: string[]; eyebrow?: string; readingTime?: number; cover?: string; coverAlt?: string; prev?: AdjacentLink; next?: AdjacentLink; }
const { title, description, date, tags = [], eyebrow, readingTime = 4, cover, coverAlt = '', prev, next } = Astro.props;
const formatted = date?.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const isPost = Boolean(date);
---
<BaseLayout title={title} description={description} image={cover ? withBase(cover) : undefined}>
  <div class="reading-progress" role="presentation"><span></span></div>
  <article class="shell article-shell">
    <header class="article-header">
      <a class="back-link" href={withBase(date ? '/writing/' : '/projects/')}>← Back to {date ? 'writing' : 'projects'}</a>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      {date && <div class="article-meta"><time datetime={date.toISOString()}>{formatted}</time><span aria-hidden="true">·</span><span>{Math.max(1, Math.ceil(readingTime))} min read</span></div>}
      {tags.length > 0 && (
        <ul class="tag-list centered" aria-label="Tags">
          {tags.map((tag) => (
            <li>{isPost ? <a href={withBase(`/writing/tags/${tag}/`)}>{tag}</a> : tag}</li>
          ))}
        </ul>
      )}
    </header>
    {cover && <figure class="article-cover"><img src={withBase(cover)} alt={coverAlt} width="1536" height="1024" /></figure>}
    <div class="prose"><slot /></div>
    {(prev || next) && (
      <nav class={`article-nav${prev && next ? '' : ' single'}`} aria-label={isPost ? 'More writing' : 'More projects'}>
        {prev && (
          <a class="article-nav-link prev" href={prev.href}>
            <span class="article-nav-label"><Icon name="arrow" /> Previous</span>
            <span class="article-nav-title">{prev.title}</span>
          </a>
        )}
        {next && (
          <a class="article-nav-link next" href={next.href}>
            <span class="article-nav-label">Next <Icon name="arrow" /></span>
            <span class="article-nav-title">{next.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>

  <script>
    function trackReadingProgress() {
      const bar = document.querySelector<HTMLElement>('.reading-progress span');
      const article = document.querySelector<HTMLElement>('.article-shell');
      if (!bar || !article) return;

      let ticking = false;
      const update = () => {
        ticking = false;
        const start = article.offsetTop;
        const distance = article.offsetHeight - window.innerHeight;
        const scrolled = window.scrollY - start;
        const ratio = distance > 0 ? Math.min(1, Math.max(0, scrolled / distance)) : 0;
        bar.style.transform = `scaleX(${ratio})`;
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      document.addEventListener('astro:before-swap', () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', update);
      }, { once: true });
      update();
    }

    document.addEventListener('astro:page-load', trackReadingProgress);
  </script>
</BaseLayout>
