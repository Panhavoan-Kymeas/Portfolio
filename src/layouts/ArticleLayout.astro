---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/paths';
interface Props { title: string; description: string; date?: Date; tags?: string[]; eyebrow?: string; readingTime?: number; }
const { title, description, date, tags = [], eyebrow, readingTime = 4 } = Astro.props;
const formatted = date?.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<BaseLayout title={title} description={description}>
  <article class="shell article-shell">
    <header class="article-header">
      <a class="back-link" href={withBase(date ? '/writing/' : '/projects/')}>← Back to {date ? 'writing' : 'projects'}</a>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      {date && <div class="article-meta"><time datetime={date.toISOString()}>{formatted}</time><span aria-hidden="true">·</span><span>{Math.max(1, Math.ceil(readingTime))} min read</span></div>}
      {tags.length > 0 && <ul class="tag-list centered" aria-label="Tags">{tags.map((tag) => <li>{tag}</li>)}</ul>}
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
