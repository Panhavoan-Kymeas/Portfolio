---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { withBase } from '../utils/paths';

interface Props {
  id: string;
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  readingTime?: number;
  draft?: boolean;
}
const { id, title, description, date, tags = [], cover, coverAlt = '', readingTime, draft = false } = Astro.props;
const formatted = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const href = withBase(`/writing/${id}/`);
const initials = title.split(/\s+/).slice(0, 2).map((w) => w[0]).join('');
---
<article class="post-row">
  <a class="post-thumb" href={href} tabindex="-1" aria-hidden="true">
    {cover
      ? <Image src={cover} alt={coverAlt} widths={[220, 440]} sizes="(max-width: 700px) 96px, 140px" loading="lazy" />
      : <span class="post-thumb-mark">{initials}</span>}
  </a>
  <div class="post-main">
    <p class="post-meta">
      <time datetime={date.toISOString()}>{formatted}</time>
      {readingTime && <><span aria-hidden="true">·</span><span>{readingTime} min read</span></>}
      {import.meta.env.DEV && draft && <span class="draft-tag">Draft</span>}
    </p>
    <h3><a href={href}>{title}</a></h3>
    {description && <p class="post-excerpt">{description}</p>}
    {tags.length > 0 && <ul class="tag-list" aria-label="Tags">{tags.map((tag) => <li><a href={withBase(`/writing/tags/${tag}/`)}>{tag}</a></li>)}</ul>}
  </div>
  <span class="post-arrow" aria-hidden="true"><Icon name="arrow" /></span>
</article>
