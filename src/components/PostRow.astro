---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { withBase } from '../utils/paths';
interface Props { id: string; title: string; description?: string; date: Date; tags?: string[]; cover?: ImageMetadata; coverAlt?: string; draft?: boolean; }
const { id, title, description, date, tags = [], cover, coverAlt = '', draft = false } = Astro.props;
const formatted = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<article class:list={['post-row', { 'has-cover': cover }]}>
  <time datetime={date.toISOString()}>{formatted}</time>
  <div>
    <h3><a href={withBase(`/writing/${id}/`)}>{title}</a>{import.meta.env.DEV && draft && <span class="draft-tag">Draft</span>}</h3>
    {description && <p>{description}</p>}
    {tags.length > 0 && <ul class="plain-tags" aria-label="Tags">{tags.map((tag) => <li><a href={withBase(`/writing/tags/${tag}/`)}>#{tag}</a></li>)}</ul>}
  </div>
  {cover && (
    <a class="row-cover post-cover" href={withBase(`/writing/${id}/`)} tabindex="-1" aria-hidden="true">
      <Image src={cover} alt={coverAlt} widths={[200, 400]} sizes="(max-width: 700px) 100px, 150px" loading="lazy" />
    </a>
  )}
</article>
