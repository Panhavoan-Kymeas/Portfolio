---
import Icon from './Icon.astro';
import { withBase } from '../utils/paths';
const pathname = Astro.url.pathname;
const home = withBase('/');
const links = [
  { href: home, label: 'Home' },
  { href: withBase('/projects/'), label: 'Projects' },
  { href: withBase('/writing/'), label: 'Writing' },
  { href: withBase('/about/'), label: 'About' },
];
const isCurrent = (href: string) => (href === home ? pathname === home : pathname.startsWith(href));
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={withBase('/')} aria-label="Kymeas Panhavoan, home">KP<span class="dot">.</span></a>
    <nav id="main-nav" aria-label="Main navigation">
      {links.map(({ href, label }) => (
        <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="icon-button theme-toggle" type="button" aria-label="Switch color theme">
        <span class="sun"><Icon name="sun" /></span><span class="moon"><Icon name="moon" /></span>
      </button>
      <button class="icon-button menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
        <span class="menu-icon"><Icon name="menu" /></span><span class="close-icon"><Icon name="close" /></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Theme is bootstrapped before paint in BaseLayout's <head>; this only wires
  // up the controls. Bound on every astro:page-load so it survives view-transition
  // navigations, which swap in a fresh header each time.
  const root = document.documentElement;

  function bindHeader() {
    const menuButton = document.querySelector<HTMLElement>('.menu-toggle');
    const setMenu = (open: boolean) => {
      root.classList.toggle('menu-open', open);
      menuButton?.setAttribute('aria-expanded', String(open));
      menuButton?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    document.querySelector('.theme-toggle')?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });

    menuButton?.addEventListener('click', () => setMenu(!root.classList.contains('menu-open')));
    document.querySelectorAll('#main-nav a').forEach((link) =>
      link.addEventListener('click', () => setMenu(false)));
  }

  // Document-level listeners: attached once for the page lifetime.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !root.classList.contains('menu-open')) return;
    root.classList.remove('menu-open');
    const btn = document.querySelector<HTMLElement>('.menu-toggle');
    btn?.setAttribute('aria-expanded', 'false');
    btn?.setAttribute('aria-label', 'Open menu');
    btn?.focus();
  });
  document.addEventListener('astro:before-swap', () => root.classList.remove('menu-open'));
  document.addEventListener('astro:page-load', bindHeader);
</script>
