---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

  return projects.map((project, i) => {
    const previous = projects[i - 1];
    const following = projects[i + 1];
    return {
      params: { id: project.id },
      props: {
        project,
        prev: previous && { href: withBase(`/projects/${previous.id}/`), title: previous.data.title },
        next: following && { href: withBase(`/projects/${following.id}/`), title: following.data.title },
      },
    };
  });
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
---
<ArticleLayout title={project.data.title} description={project.data.description} tags={project.data.technologies} eyebrow="Project notes" cover={project.data.cover} coverAlt={project.data.coverAlt} prev={prev} next={next}>
  <div class="project-actions">
    {project.data.github && <a class="button primary" href={project.data.github}><Icon name="github" /> View source</a>}
    {project.data.demo && <a class="button secondary" href={project.data.demo}>Live demo <Icon name="external" /></a>}
  </div>
  <Content />
</ArticleLayout>
