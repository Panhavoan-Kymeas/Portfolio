---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../utils/paths';

const projects = (await getCollection('projects')).filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const posts = (await getCollection('posts')).filter((p) => !p.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<BaseLayout>
  <section class="shell hero">
    <p class="eyebrow">Hello, I’m Alex <span aria-hidden="true">👋</span></p>
    <h1>I build for the web<br />and write to <em>understand.</em></h1>
    <p class="hero-copy">I’m a software developer who enjoys turning fuzzy ideas into useful, thoughtful products. This is where I share my work and notes from things I’m learning.</p>
    <div class="hero-links">
      <a class="button primary" href={withBase('/projects/')}>See my work <Icon name="arrow" /></a>
      <a class="text-link" href="https://github.com/Panhavoan-Kymeas"><Icon name="github" /> GitHub</a>
      <a class="text-link" href="https://www.linkedin.com/in/panhavoan-kymeas-28b241314">LinkedIn ↗</a>
    </div>
  </section>

  <section class="shell home-section ruled-section">
    <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2>Featured projects</h2></div><a href={withBase('/projects/')}>All projects <Icon name="arrow" /></a></div>
    <div>{projects.map((project) => <ProjectRow id={project.id} {...project.data} />)}</div>
  </section>

  <section class="shell home-section ruled-section">
    <div class="section-heading"><div><p class="eyebrow">From the notebook</p><h2>Recent writing</h2></div><a href={withBase('/writing/')}>All writing <Icon name="arrow" /></a></div>
    <div>{posts.map((post) => <PostRow id={post.id} {...post.data} />)}</div>
  </section>

  <section class="shell currently">
    <p class="eyebrow">Currently</p>
    <p>Learning more about distributed systems, experimenting with local-first software, and trying to make a decent pour-over coffee.</p>
    <span class="updated">Updated August 2026</span>
  </section>
</BaseLayout>
