---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import CvList from '../components/CvList.astro';
import Icon from '../components/Icon.astro';
import { experience } from '../data/resume';
import { readingTime } from '../utils/reading-time';
import { withBase } from '../utils/paths';

const projects = (await getCollection('projects')).filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const posts = (await getCollection('posts')).filter((p) => !p.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const recentExperience = experience.slice(0, 3);
---
<BaseLayout>
  <section class="shell hero">
    <div class="hero-kicker">
      <p class="eyebrow">Hello, I’m Panhavoan <span aria-hidden="true">👋</span></p>
      <span>Phnom Penh · UTC+7</span>
    </div>
    <h1>I build back ends<br />and write to <em>understand.</em></h1>
    <p class="hero-copy">I’m a back-end developer in Phnom Penh, working mostly in Java and Python. This is where I keep my projects and notes from the things I’m figuring out.</p>
    <div class="hero-links">
      <a class="button primary" href={withBase('/projects/')}>See my work <Icon name="arrow" /></a>
      <a class="text-link" href="https://github.com/Panhavoan-Kymeas"><Icon name="github" /> GitHub ↗</a>
      <a class="text-link" href="https://www.linkedin.com/in/panhavoan-kymeas-28b241314"><Icon name="linkedin" /> LinkedIn ↗</a>
    </div>
  </section>

  <section class="shell home-section ruled-section">
    <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2>Featured projects</h2></div><span class="section-number">01 / 04</span><a href={withBase('/projects/')}>All projects <Icon name="arrow" /></a></div>
    <div class="project-grid">{projects.map((project) => <ProjectCard id={project.id} {...project.data} />)}</div>
  </section>

  <section class="shell home-section ruled-section">
    <div class="section-heading"><div><p class="eyebrow">Where I’ve worked</p><h2>Experience</h2></div><span class="section-number">02 / 04</span><a href={withBase('/resume/')}>Full résumé <Icon name="arrow" /></a></div>
    <CvList items={recentExperience} />
  </section>

  <section class="shell home-section ruled-section">
    <div class="section-heading"><div><p class="eyebrow">From the notebook</p><h2>Recent writing</h2></div><span class="section-number">03 / 04</span><a href={withBase('/writing/')}>All writing <Icon name="arrow" /></a></div>
    <div>{posts.map((post) => <PostRow id={post.id} readingTime={readingTime(post.body)} {...post.data} />)}</div>
  </section>

  <section class="shell currently">
    <div><p class="eyebrow">Currently</p><span class="section-number">04 / Now</span></div>
    <p>Building back-end services at Innotech Solutions, and working through the DataTalks.Club Data Engineering Zoomcamp on the side.</p>
    <span class="updated">Updated September 2026</span>
  </section>
</BaseLayout>
